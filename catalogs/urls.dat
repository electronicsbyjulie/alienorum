# Mermilliod photoelectric UBV means for apparent V magnitude and B-V / U-B colors.
Mermilliod      Mermilliod.tsv              https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20%2A%20FROM%20%22II%2F168%2Fubvmeans%22

Skiff           Skiff.tsv                   https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20%2A%20FROM%20%22B%2Fmk%2Fmktypes%22%20WHERE%20Mag%3C12%20OR%20Mag%20IS%20NULL

WDS             WDS.tsv                     https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20%2A%20FROM%20%22B%2Fwds%2Fwds%22

SBX             SBX_systems.tsv             https://astro.ulb.ac.be/sbx/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20%2A%20FROM%20systems
SBX             SBX_alias.tsv               https://astro.ulb.ac.be/sbx/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20%2A%20FROM%20alias
SBX             SBX_orbits.tsv              https://astro.ulb.ac.be/sbx/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20%2A%20FROM%20orbits

GAIA            Gaia_DR3.tsv                https://gea.esac.esa.int/tap-server/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20g.source_id%2Cn.original_ext_source_id%20AS%20HIP%2Cn.number_of_neighbours%2Cg.ra%2Cg.dec%2Cg.ref_epoch%2Cg.parallax%2Cg.parallax_error%2Cg.pmra%2Cg.pmdec%2Cg.radial_velocity%2Cg.ruwe%2Cg.teff_gspphot%2Cg.teff_gspphot_lower%2Cg.teff_gspphot_upper%20FROM%20gaiadr3.gaia_source%20g%20JOIN%20gaiadr3.hipparcos2_best_neighbour%20n%20ON%20g.source_id%3Dn.source_id

VSX             VSX.tsv                     https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20%2A%20FROM%20%22B%2Fvsx%2Fvsx%22%20WHERE%20%22max%22%3C11%20AND%20n_max%3D%27V%27

DEBCat          DEBCat.debcat               https://astro.keele.ac.uk/jkt/debcat/debs.dat

ORB6            ORB6.orb6                   https://crf.usno.navy.mil/data_products/WDS/orb6/orb6orbits.txt

IAU             IAU.iau                     https://exopla.net/star-names/modern-iau-star-names/

