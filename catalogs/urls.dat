# Field-specific stellar references; fetched by the reference client.

# SIMBAD for stellar ID cross-reference.
SIMBAD          SIMBAD.tsv                  https://simbad.cds.unistra.fr/simbad/sim-tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20b.oid%2Cb.main_id%2Cb.otype%2Cb.ra%2Cb.dec%2Cb.sp_type%2Cb.sp_qual%2Cb.sp_bibcode%2Cb.plx_value%2Cb.plx_err%2Cb.plx_bibcode%2Cb.pmra%2Cb.pmdec%2Cb.rvz_radvel%2Cb.rvz_bibcode%2Ci.ids%2Cf.V%2Cf.B%2Cf.U%20FROM%20basic%20b%20JOIN%20ids%20i%20ON%20i.oidref%3Db.oid%20LEFT%20JOIN%20allfluxes%20f%20ON%20f.oidref%3Db.oid%20WHERE%20%28f.V%3C11%20OR%20b.plx_value%3E10%29%20AND%20b.ra%3E%3D0%20AND%20b.ra%3C30
SIMBAD          SIMBAD_1.tsv                https://simbad.cds.unistra.fr/simbad/sim-tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=tsv&MAXREC=2000000&QUERY=SELECT%20b.oid%2Cb.main_id%2Cb.otype%2Cb.ra%2Cb.dec%2Cb.sp_type%2Cb.sp_qual%2Cb.sp_bibcode%2Cb.plx_value%2Cb.plx_err%2Cb.plx_bibcode%2Cb.pmra%2Cb.pmdec%2Cb.rvz_radvel%2Cb.rvz_bibcode%2Ci.ids%2Cf.V%2Cf.B%2Cf.U%20FROM%20basic%20b%20JOIN%20ids%20i%20ON%20i.oidref%3Db.oid%20LEFT%20JOIN%20allfluxes%20f%20ON%20f.oidref%3Db.oid%20WHERE%20%28f.V%3C11%20OR%20b.plx_value%3E10%29%20AND%20b.ra%3E%3D30%20AND%20b.ra%3C60
